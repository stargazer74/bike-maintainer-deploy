# Copy to .env next to compose.yaml and fill in. .env is gitignored – never commit real values.

# Password of the database user (required). Choose any long random value; you never need to type it.
BM_DB_PASSWORD=

# Port the app is reachable on in your home network (default 8080).
# BM_PORT=8080

# Release of backend and frontend (same number for both). Default "0" follows the newest 0.x release. While the
# version starts with 0, every minor release (0.1 → 0.2) may contain breaking changes – pin an exact release with
# e.g. BM_VERSION=0.1.0 if in doubt.
# BM_VERSION=0
