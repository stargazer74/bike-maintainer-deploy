# Local development only. Copy to .env next to compose.yaml – it is gitignored.

# Database user "maintenance" of the app (also the phpMyAdmin login).
BM_DB_PASSWORD=dev-db-password
# Database user "wordpress" of the website; only applied on the very first start of the database.
BM_WEBSITE_DB_PASSWORD=dev-website-db-password

# Initial admin of the app.
BM_INITIAL_ADMIN_EMAIL=admin@example.org
BM_INITIAL_ADMIN_PASSWORD=dev-admin-password

# Admin of the website (bm-setup).
BM_WEBSITE_ADMIN_USER=admin
BM_WEBSITE_ADMIN_EMAIL=admin@example.org
BM_WEBSITE_ADMIN_PASSWORD=dev-admin-password

# Optional: subscription against the Paddle sandbox (https://sandbox-vendors.paddle.com). Without these values the
# checkout answers 503. Default payment link in the sandbox: http://localhost:8100/abo/bezahlen. Webhooks only reach
# the stack through a tunnel to http://localhost:8100/api/v1/webhooks/paddle.
# BM_PADDLE_API_KEY=
# BM_PADDLE_WEBHOOK_SECRET=
# BM_PADDLE_PRICE_ID=
# BM_PADDLE_CLIENT_TOKEN=
# Early end after the first year against the sandbox.
# BM_EARLY_END_ENABLED=true
# Length of the free trial in days (default 7).
# BM_SUBSCRIPTION_TRIAL_DAYS=7

# Ports on localhost.
# APP_PORT=8100
# WEBSITE_PORT=8200
# MAILPIT_PORT=8026
# PHPMYADMIN_PORT=8101
