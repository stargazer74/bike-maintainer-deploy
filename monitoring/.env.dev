# Development values for compose.dev.yaml – no secrets, never use for operation.
PROXY_NETWORK=bike-maintainer-dev_default
BM_GRAFANA_ADMIN_PASSWORD=dev-admin-password
BM_GRAFANA_URL=http://localhost:8300
BM_GRAFANA_COOKIE_SECURE=false
# Mailpit of the dev stack: STARTTLS with a self-signed certificate, any login accepted.
BM_SMTP_HOST=bike-maintainer-mailpit:1025
BM_SMTP_USER=dev
BM_SMTP_PASSWORD=dev
BM_SMTP_FROM=noreply@example.org
BM_ALERT_EMAIL=alert@example.org
BM_SMTP_STARTTLS_POLICY=OpportunisticStartTLS
BM_SMTP_SKIP_VERIFY=true
# Overridden by compose.dev.yaml (HTTP inside the Docker network); set because compose.yaml requires them.
BM_PROBE_APP_URL=http://bike-maintainer-dev-frontend/
BM_PROBE_WEBSITE_URL=http://bike-maintainer-dev-website/
