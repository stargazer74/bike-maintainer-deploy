# Copy to .env next to compose.yaml and fill in. .env is gitignored – never commit real values.

# Docker network of the existing nginx-proxy-manager (as in portal/.env); only Grafana joins it.
PROXY_NETWORK=

# Password of the Grafana user "admin" (required), e.g. `openssl rand -base64 24`.
BM_GRAFANA_ADMIN_PASSWORD=

# Address of Grafana behind the proxy (proxy host in the nginx-proxy-manager, with TLS).
BM_GRAFANA_URL=https://monitoring.bike-maintainer.de

# Alert mails: SMTP of noreply@bike-maintainer.de at IONOS (STARTTLS on 587). Password required.
BM_SMTP_HOST=smtp.ionos.de:587
BM_SMTP_USER=noreply@bike-maintainer.de
BM_SMTP_PASSWORD=
BM_SMTP_FROM=noreply@bike-maintainer.de

# Recipient of all alerts; the mailbox (or a forwarding) must exist at IONOS.
BM_ALERT_EMAIL=alert@bike-maintainer.de

# Probed addresses (defaults: the public addresses of app and website).
# BM_PROBE_APP_URL=https://app.bike-maintainer.de
# BM_PROBE_WEBSITE_URL=https://bike-maintainer.de
