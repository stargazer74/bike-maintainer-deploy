# Copy to .env next to compose.yaml and fill in. .env is gitignored – never commit real values.

# Docker network of the existing nginx-proxy-manager (as in portal/.env); only Grafana joins it.
PROXY_NETWORK=

# Password of the Grafana user "admin" (required), e.g. `openssl rand -base64 24`.
BM_GRAFANA_ADMIN_PASSWORD=

# Address of Grafana behind the proxy (required; proxy host in the nginx-proxy-manager, with TLS),
# e.g. https://monitoring.example.com
BM_GRAFANA_URL=

# Alert mails: SMTP with STARTTLS (required), usually the same sending mailbox as the app, e.g.
# smtp.example.com:587 and noreply@example.com. The sender defaults to BM_SMTP_USER.
BM_SMTP_HOST=
BM_SMTP_USER=
BM_SMTP_PASSWORD=
# BM_SMTP_FROM=

# Recipient of all alerts (required); the mailbox (or a forwarding) must exist.
BM_ALERT_EMAIL=

# Probed public addresses of app and website (required), e.g. https://app.example.com and https://example.com
BM_PROBE_APP_URL=
BM_PROBE_WEBSITE_URL=
