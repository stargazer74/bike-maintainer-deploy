# Copy to .env next to compose.yaml and fill in. .env is gitignored – never commit real values.

# Password of the database user "maintenance" (required). Any long random value, e.g. `openssl rand -base64 24`;
# also the phpMyAdmin login.
BM_DB_PASSWORD=

# Initial admin (owner of all vehicles from before user accounts). The email is only read when
# migration V4 runs; the password is only applied while the admin has none.
BM_INITIAL_ADMIN_EMAIL=
BM_INITIAL_ADMIN_PASSWORD=

# Registration emails via SMTP (IONOS, STARTTLS on 587). SPRING_MAIL_PASSWORD is required; the backend refuses to
# start in portal mode without SMTP.
SPRING_MAIL_HOST=smtp.ionos.de
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=noreply@bike-maintainer.de
SPRING_MAIL_PASSWORD=
BM_MAIL_FROM=noreply@bike-maintainer.de

# Address of the app, used for the links in emails (no trailing slash).
BM_PUBLIC_URL=https://app.bike-maintainer.de

# Secret for the registration captcha (required), e.g. `openssl rand -hex 32`. Changing it invalidates only
# challenges that are currently being solved.
BM_ALTCHA_HMAC_KEY=

# Docker network of the existing nginx-proxy-manager (see `docker network ls`, often "<directory>_default").
# The frontend joins it so the proxy can reach it as bike-maintainer-frontend:80.
PROXY_NETWORK=

# Release of backend and frontend (same number for both). Default "0" follows the newest 0.x release. While the
# version starts with 0, every minor release (0.1 → 0.2) may contain breaking changes – pin an exact release with
# e.g. BM_VERSION=0.1.0 if in doubt.
# BM_VERSION=0

# --- Website (bike-maintainer.de, WordPress) ---

# Password of the database user "wordpress" (required), e.g. `openssl rand -base64 24`. The user only has rights on
# the database "wordpress", never on the app data. Created on the first start of an empty database; for an existing
# installation see README.
BM_WEBSITE_DB_PASSWORD=

# Own captcha secret for registration and lost password of website and forum (required), e.g. `openssl rand -hex 32`.
# Deliberately different from BM_ALTCHA_HMAC_KEY of the app.
BM_WEBSITE_ALTCHA_HMAC_KEY=

# Only for the first installation (`docker compose exec -u www-data bike-maintainer-website bm-setup`): address of the
# website and its administrator. Remove at least BM_WEBSITE_ADMIN_PASSWORD from .env afterwards and recreate the
# container (`docker compose up -d bike-maintainer-website`), otherwise it stays in the container's environment.
BM_WEBSITE_URL=https://bike-maintainer.de
BM_WEBSITE_ADMIN_USER=admin
BM_WEBSITE_ADMIN_EMAIL=
BM_WEBSITE_ADMIN_PASSWORD=

# Release of the website image (own versioning, independent of BM_VERSION). Default "0" follows the newest 0.x release.
# BM_WEBSITE_VERSION=0

