# Copy to .env next to compose.yaml and fill in. .env is gitignored – never commit real values.
# No `$` in values: Compose reads it as the start of a variable and cuts or changes the value (output of
# `openssl rand -base64`/`-hex` never contains one).

# Password of the database user "maintenance" (required). Any long random value, e.g. `openssl rand -base64 24`;
# also the phpMyAdmin login.
BM_DB_PASSWORD=

# Initial admin (owner of all vehicles from before user accounts). The email is only read when
# migration V4 runs; the password is only applied while the admin has none and needs at least 10 characters,
# otherwise the backend does not start (e.g. `openssl rand -base64 18`).
BM_INITIAL_ADMIN_EMAIL=
BM_INITIAL_ADMIN_PASSWORD=

# Emails of app and website via SMTP with STARTTLS (required; the backend refuses to start in portal mode without
# SMTP). Host, login and password of the sending mailbox at your mail provider, e.g. smtp.example.com and
# noreply@example.com.
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
# Sender address; defaults to SPRING_MAIL_USERNAME (most providers accept no other sender).
# BM_MAIL_FROM=

# Public address of the app (required, no trailing slash), e.g. https://app.example.com: links in emails and the
# "to the app" links of the website.
BM_PUBLIC_URL=

# Secret for the registration captcha (required), e.g. `openssl rand -hex 32`. Changing it invalidates only
# challenges that are currently being solved.
BM_ALTCHA_HMAC_KEY=

# Length of the free trial in days (required). A business decision of the operator, therefore no default here.
BM_SUBSCRIPTION_TRIAL_DAYS=

# Yearly gross price in euros shown on the website, e.g. 9.99 (optional). Empty = the website shows no offer yet.
# The price customers pay is the one of the product in Polar – keep both the same.
BM_SUBSCRIPTION_PRICE=

# Subscription via Polar (required, see README "Abo über Polar"). Organization access token, secret of the webhook
# endpoint (whsec_…) and id of the yearly product. For the Polar sandbox also set
# BM_POLAR_API_URL=https://sandbox-api.polar.sh and use the sandbox values.
BM_POLAR_ACCESS_TOKEN=
BM_POLAR_WEBHOOK_SECRET=
BM_POLAR_PRODUCT_ID=
# BM_POLAR_API_URL=https://api.polar.sh
# true = end subscriptions cancelled after the first year automatically one month later and refund the rest pro rata
# (see README); the access token then also needs orders:read and refunds:write. Default false: admins get an email.
# BM_POLAR_EARLY_END_ENABLED=false

# Docker network of the existing nginx-proxy-manager (see `docker network ls`, often "<directory>_default").
# The frontend joins it so the proxy can reach it as bike-maintainer-frontend:80.
PROXY_NETWORK=

# Release of backend and frontend (same number for both). Default "0" follows the newest 0.x release. While the
# version starts with 0, every minor release (0.1 → 0.2) may contain breaking changes – pin an exact release with
# e.g. BM_VERSION=0.1.0 if in doubt.
# BM_VERSION=0

# --- Website (WordPress) ---

# Password of the database user "wordpress" (required), e.g. `openssl rand -base64 24`. The user only has rights on
# the database "wordpress", never on the app data. Created on the first start of an empty database; for an existing
# installation see README.
BM_WEBSITE_DB_PASSWORD=

# Own captcha secret for registration and lost password of website and forum (required), e.g. `openssl rand -hex 32`.
# Deliberately different from BM_ALTCHA_HMAC_KEY of the app.
BM_WEBSITE_ALTCHA_HMAC_KEY=

# Public address of the website, e.g. https://www.example.com: used for the first installation and by the app, which
# links to the website, its legal notice and privacy policy (empty: no links in the app).
BM_WEBSITE_URL=

# Only for the first installation (`docker compose exec -u www-data bike-maintainer-website bm-setup`): the
# administrator of the website. Remove at least BM_WEBSITE_ADMIN_PASSWORD from .env afterwards and recreate the
# container (`docker compose up -d bike-maintainer-website`), otherwise it stays in the container's environment.
BM_WEBSITE_ADMIN_USER=admin
BM_WEBSITE_ADMIN_EMAIL=
BM_WEBSITE_ADMIN_PASSWORD=

# Release of the website image (own versioning, independent of BM_VERSION). Default "0" follows the newest 0.x release.
# BM_WEBSITE_VERSION=0

