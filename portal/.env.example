# Copy to .env next to compose.yaml and fill in. .env is gitignored – never commit real values.

# Initial admin (owner of all vehicles from before user accounts). The email is only read when
# migration V4 runs; the password is only applied while the admin has none.
BM_INITIAL_ADMIN_EMAIL=
BM_INITIAL_ADMIN_PASSWORD=

# Docker network of the existing nginx-proxy-manager (see `docker network ls`, often "<directory>_default").
# Frontend and backend join it so the proxy can reach them by service name.
PROXY_NETWORK=
